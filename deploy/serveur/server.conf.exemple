# /etc/mirador/server.conf — fichier de démarrage de mirador-server.
# Seulement ce qui est nécessaire au démarrage : tout le reste se règle dans
# l'interface. Une clé inconnue empêche le démarrage.

MIRADOR_ECOUTE_AGENTS=0.0.0.0:9440
MIRADOR_ECOUTE_INTERFACE=0.0.0.0:9441
MIRADOR_DONNEES=/var/lib/mirador
MIRADOR_FICHIER_CLE=/run/secrets/mirador_cle
# Adresse de nginx vue depuis le conteneur (passerelle du réseau « obs ») :
# seule autorisée à transmettre l'IP réelle du client.
MIRADOR_PROXY=172.30.0.1
