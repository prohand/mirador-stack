{
 "version": 1,
 "nom": "linux",
 "titre": "Linux",
 "icone": "machines",
 "description": "Socle de toute machine Linux : services systemd, mises à jour en attente, et seuils CPU, charge, mémoire, disque et inodes réglables par machine.",
 "detection": "count by (instance) (node_uname_info)",
 "config": {
  "systemd": true,
  "mises_a_jour": true,
  "envoyer_pare_feu": true
 },
 "parametres": [
  {
   "nom": "cpu_pct",
   "titre": "CPU : alerte au-dessus de",
   "unite": "%",
   "defaut": 90,
   "min": 10,
   "max": 100
  },
  {
   "nom": "charge_par_coeur",
   "titre": "Charge (load 5 min) par cœur : alerte au-dessus de",
   "defaut": 2,
   "min": 0.5,
   "max": 50
  },
  {
   "nom": "memoire_libre_pct",
   "titre": "Mémoire disponible : alerte en dessous de",
   "unite": "%",
   "defaut": 10,
   "min": 1,
   "max": 90
  },
  {
   "nom": "disque_libre_pct",
   "titre": "Espace disque libre : alerte en dessous de",
   "unite": "%",
   "defaut": 15,
   "min": 1,
   "max": 90
  },
  {
   "nom": "inodes_libres_pct",
   "titre": "Inodes libres : alerte en dessous de",
   "unite": "%",
   "defaut": 10,
   "min": 1,
   "max": 90
  },
  {
   "nom": "trafic_mbits",
   "titre": "Trafic entrant d'une interface : alerte au-dessus de",
   "unite": "Mbit/s",
   "defaut": 800,
   "min": 1,
   "max": 100000
  }
 ],
 "regles": [
  {
   "nom": "LinuxCpuEleve",
   "remplace": "CpuEleve",
   "pour": "1m",
   "gravite": "warning",
   "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100) > $cpu_pct",
   "resume": "CPU à {{ $value | humanize }} % sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxChargeElevee",
   "remplace": "LoadAverageEleve",
   "pour": "10m",
   "gravite": "warning",
   "expr": "node_load5 / on (instance) count by (instance) (node_cpu_seconds_total{mode=\"idle\"}) > $charge_par_coeur",
   "resume": "Charge de {{ $value | humanize }} par cœur sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxMemoireFaible",
   "remplace": "MemoireFaible",
   "pour": "10m",
   "gravite": "warning",
   "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100 < $memoire_libre_pct",
   "resume": "Plus que {{ $value | humanize }} % de mémoire disponible sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxDisqueFaible",
   "remplace": "DisqueFaible",
   "pour": "5m",
   "gravite": "warning",
   "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes * 100 < $disque_libre_pct",
   "resume": "{{ $labels.mountpoint }} : plus que {{ $value | humanize }} % libre sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxInodesFaibles",
   "remplace": "InodesFaibles",
   "pour": "15m",
   "gravite": "warning",
   "expr": "node_filesystem_files_free{fstype!~\"tmpfs|overlay\"} / node_filesystem_files * 100 < $inodes_libres_pct",
   "resume": "{{ $labels.mountpoint }} : plus que {{ $value | humanize }} % d'inodes libres sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxServiceEnEchec",
   "remplace": "ServiceSystemdEnEchec",
   "pour": "5m",
   "gravite": "critical",
   "expr": "node_systemd_unit_state{state=\"failed\", name!=\"fwupd-refresh.service\"} == 1",
   "resume": "Service {{ $labels.name }} en échec sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxServiceAutoArrete",
   "remplace": "ServiceAutomatiqueArrete",
   "pour": "10m",
   "gravite": "warning",
   "expr": "node_systemd_unit_enabled_active == 0",
   "resume": "Service {{ $labels.name }} (démarrage automatique) arrêté sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxServiceEnBoucle",
   "remplace": "ServiceRedemarreEnBoucle",
   "pour": "10m",
   "gravite": "warning",
   "expr": "increase(node_systemd_service_restart_total[1h]) > 5",
   "resume": "Service {{ $labels.name }} redémarré {{ $value | humanize }} fois en 1 h sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxSwapIntensif",
   "remplace": "SwapIntensif",
   "pour": "15m",
   "gravite": "warning",
   "expr": "rate(node_vmstat_pswpin[10m]) + rate(node_vmstat_pswpout[10m]) > 100",
   "resume": "Échanges intensifs avec le swap sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxDisqueBientotPlein",
   "remplace": "DisqueSaturationPrevue",
   "pour": "1h",
   "gravite": "warning",
   "expr": "predict_linear(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"}[12h], 4*24*3600) < 0 and node_filesystem_avail_bytes / node_filesystem_size_bytes < 0.30",
   "resume": "{{ $labels.mountpoint }} sera plein sous 4 jours sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxIoDisqueSature",
   "remplace": "IoDisqueSature",
   "pour": "15m",
   "gravite": "warning",
   "expr": "rate(node_disk_io_time_seconds_total[5m]) > 0.9",
   "resume": "Disque {{ $labels.device }} occupé à plus de 90 % sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxErreursReseau",
   "remplace": "ErreursReseau",
   "pour": "15m",
   "gravite": "warning",
   "expr": "rate(node_network_receive_errs_total[10m]) + rate(node_network_transmit_errs_total[10m]) > 1",
   "resume": "Erreurs réseau sur {{ $labels.device }} ({{ $labels.instance }})"
  },
  {
   "nom": "LinuxRedemarre",
   "remplace": "RedemarrageInattendu",
   "gravite": "info",
   "expr": "node_time_seconds - node_boot_time_seconds < 300",
   "resume": "{{ $labels.instance }} vient de redémarrer"
  },
  {
   "nom": "LinuxPareFeuOuvert",
   "remplace": "PareFeuNonRestrictif",
   "pour": "5m",
   "gravite": "critical",
   "expr": "node_firewall_input_policy_drop == 0",
   "resume": "Pare-feu non restrictif en entrée sur {{ $labels.instance }}"
  },
  {
   "nom": "LinuxTraficAnormal",
   "remplace": "TraficAnormal",
   "pour": "10m",
   "gravite": "warning",
   "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[5m]) * 8 / 1000000 > $trafic_mbits",
   "resume": "Trafic entrant élevé sur {{ $labels.device }} ({{ $labels.instance }}) : {{ $value | humanize }} Mbit/s"
  }
 ]
}
